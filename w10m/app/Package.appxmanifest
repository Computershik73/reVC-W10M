<?xml version="1.0" encoding="utf-8"?>
<!-- reVC (Grand Theft Auto: Vice City, reverse-engineered) for Windows 10 Mobile.
     @VERSION@, @IDENTITY@, @PUBLISHER@ and @PHONEID@ are filled in by tools/build.py.
     No capabilities: the game's folder comes through the system's folder picker, and nothing
     here goes on the network. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    IgnorableNamespaces="uap mp">

  <Identity
      Name="@IDENTITY@"
      Publisher="@PUBLISHER@"
      Version="@VERSION@"
      ProcessorArchitecture="arm" />

  <mp:PhoneIdentity
      PhoneProductId="@PHONEID@"
      PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>reVC</DisplayName>
    <PublisherDisplayName>Computershik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 Mobile from Threshold 2 (10586) to its last build (15254). Windows.Universal
         also lets the package onto Windows 10 for ARM32 desktops, as butterscotch-w10m's does. -->
    <TargetDeviceFamily Name="Windows.Mobile" MinVersion="10.0.10586.0" MaxVersionTested="10.0.15254.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10586.0" MaxVersionTested="10.0.15254.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="reVC.exe" EntryPoint="reVC.App">
      <uap:VisualElements
          DisplayName="reVC"
          Description="Grand Theft Auto: Vice City, reverse-engineered (reVC), for Windows 10 Mobile. Needs your own copy of the game."
          BackgroundColor="#14091C"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            ShortName="reVC"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png"
            Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#14091C" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="landscape" />
          <uap:Rotation Preference="landscapeFlipped" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
