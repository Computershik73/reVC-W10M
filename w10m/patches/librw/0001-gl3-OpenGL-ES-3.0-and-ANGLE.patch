+struct Page
+{
+	Page *next;
+	uint32 vbo, ibo, vao;
+	int32 numAttribs;
+	AttribDesc attribs[12];
+	uint32 stride;
+	int32 numUsers;
+	Extent *freeVertices, *freeIndices;
+	int32 numFreeVertices, numFreeIndices;
+	int32 maxFreeVertices, maxFreeIndices;
