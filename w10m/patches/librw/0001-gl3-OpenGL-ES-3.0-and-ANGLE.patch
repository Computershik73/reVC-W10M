+static bool32
+takeExtent(Extent *free, int32 *num, uint32 count, uint32 *start)
+{
+	for(int32 i = 0; i < *num; i++)
+		if(free[i].count >= count){
+			*start = free[i].start;
+			free[i].start += count;
+			free[i].count -= count;
+			if(free[i].count == 0){
+				memmove(&free[i], &free[i+1], (*num-i-1)*sizeof(Extent));
+				(*num)--;
+			}
+			return 1;
+		}
+	return 0;
