+			program = 0;
+		}
+	}
+	free(data);
+	fclose(f);
+	*length = head[2];
+	return program;
+}
+
+// the length of what was written, 0 if nothing was
+static GLint
+saveProgramBinary(uint64 key, GLuint program)
+{
+	char path[600], partial[600];
+	GLint length = 0;
+	GLsizei written = 0;
+	GLenum format = 0;
