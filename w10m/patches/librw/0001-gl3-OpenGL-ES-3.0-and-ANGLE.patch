+// gl3Caps.verticesFromMemory: the vertices where the application has them. Nothing is bound
+// as the array buffer, and the default vertex array's pointers are into memory; they are read
+// when the draw is made, so the vertices are to stay as they are until then (as RenderWare's
+// own immediate mode asks: until the draw returns, or until im3DEnd).
+static void
+memoryPointers(AttribDesc *attribDescs, int32 numAttribs, void *vertices)
+{
+	AttribDesc *a;
+	useDefaultVertexArray();
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+	for(a = attribDescs; a != &attribDescs[numAttribs]; a++){
+		glEnableVertexAttribArray(a->index);
+		glVertexAttribPointer(a->index, a->size, a->type, a->normalized,
+		                      a->stride, (uint8*)vertices + a->offset);
+	}
+}
+
+static void
+immediateDone(uint64 t0)
+{
+	if(perf.enabled){
+		perf.immediateNs += perfNow() - t0;
+		perf.immediates++;
+		perf.changed = 0;
+	}
+}
+
+// A buffer orphaned at its full size and then filled in part is the quick way with a desktop
+// driver. ANGLE allocates and clears the full size for it, 360 KB of vertices for every
+// immediate draw: on OpenGL ES the buffer is given what is drawn, in one call.
+static void
+streamData(GLenum target, GLsizeiptr fullSize, GLsizeiptr size, const void *data)
+{
+	if(gl3Caps.gles){
+		glBufferData(target, size, data, GL_STREAM_DRAW);
+		return;
+	}
+	glBufferData(target, fullSize, nil, GL_STREAM_DRAW);
+	glBufferSubData(target, 0, size, data);
+}
